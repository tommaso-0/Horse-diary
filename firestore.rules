rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.userId == request.auth.uid; }
    function ownsNew() { return signedIn() && request.resource.data.userId == request.auth.uid; }
    match /horses/{horseId} {
      allow get, list: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.sharedVisible == true);
      allow create: if ownsNew();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
      allow delete: if ownsExisting();
    }
    match /performances/{performanceId} {
      allow get, list: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.shared == true);
      allow create: if ownsNew();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
      allow delete: if ownsExisting();
    }
    match /profiles/{userId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /_meta/counters {
      allow get: if signedIn();
      allow list, create, delete: if false;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextHorseId', 'nextPerformanceId'])
        && (
          (request.resource.data.nextHorseId == resource.data.nextHorseId + 1
            && request.resource.data.nextPerformanceId == resource.data.nextPerformanceId)
          ||
          (request.resource.data.nextPerformanceId == resource.data.nextPerformanceId + 1
            && request.resource.data.nextHorseId == resource.data.nextHorseId)
        );
    }
  }
}
